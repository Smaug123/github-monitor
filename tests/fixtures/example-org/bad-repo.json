{
  "repo": {
    "owner": "example-org",
    "name": "bad-repo"
  },
  "settings": {
    "private": false,
    "archived": false,
    "disabled": false,
    "allow_auto_merge": false,
    "delete_branch_on_merge": false,
    "allow_update_branch": false,
    "allow_squash_merge": false,
    "allow_merge_commit": true,
    "allow_rebase_merge": false,
    "fork_pr_approval_policy": "first_time_contributors"
  },
  "rulesets": [],
  "default_branch": "main",
  "legacy_branch_protection": {},
  "workflows": [
    {
      "path": ".github/workflows/unsafe.yml",
      "workflow": {
        "name": "Unsafe CI",
        "on": {
          "pull_request_target": {}
        },
        "jobs": {
          "build": {
            "runs-on": "ubuntu-latest",
            "steps": [
              {
                "uses": "actions/checkout@v4"
              },
              {
                "run": "echo unsafe"
              }
            ]
          }
        }
      },
      "raw_yaml": "name: Unsafe CI\non:\n  pull_request_target: {}\njobs:\n  build:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - run: echo unsafe\n"
    },
    {
      "path": ".github/workflows/post-ci.yml",
      "workflow": {
        "name": "Post-CI",
        "on": {
          "workflow_run": {}
        },
        "jobs": {
          "audit": {
            "runs-on": "ubuntu-latest",
            "steps": [
              {
                "run": "echo audit"
              }
            ]
          }
        }
      },
      "raw_yaml": "name: Post-CI\non:\n  workflow_run: {}\njobs:\n  audit:\n    runs-on: ubuntu-latest\n    steps:\n      - run: echo audit\n"
    },
    {
      "path": ".github/workflows/reusable-caller.yml",
      "workflow": {
        "name": "Reusable Caller",
        "on": {
          "pull_request": {}
        },
        "jobs": {
          "call-release": {
            "uses": "example-org/shared/.github/workflows/release.yml@main"
          }
        }
      },
      "raw_yaml": "name: Reusable Caller\non:\n  pull_request: {}\njobs:\n  call-release:\n    uses: example-org/shared/.github/workflows/release.yml@main\n"
    },
    {
      "path": ".github/workflows/pr-secrets.yml",
      "workflow": {
        "name": "PR Secrets",
        "on": {
          "pull_request": {}
        },
        "jobs": {
          "leak": {
            "runs-on": "ubuntu-latest",
            "steps": [
              {
                "run": "echo $NPM_TOKEN"
              }
            ]
          }
        }
      },
      "raw_yaml": "name: PR Secrets\non:\n  pull_request: {}\njobs:\n  leak:\n    runs-on: ubuntu-latest\n    steps:\n      - run: echo $NPM_TOKEN\n        env:\n          NPM_TOKEN: ${{ secrets.NPM_TOKEN }}\n"
    }
  ],
  "files_present": [
    ".github/workflows/post-ci.yml",
    ".github/workflows/pr-secrets.yml",
    ".github/workflows/reusable-caller.yml",
    ".github/workflows/unsafe.yml",
    "README.md"
  ]
}
